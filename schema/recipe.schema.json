{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "type": "object",

  "required": [
    "title",
    "authors",
    "ingredients",
    "instructions"
  ],

  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },

    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1
          },

          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ingredient"
            }
          }
        },
        "additionalProperties": false
      }
    },

    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action",
          "content"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "assemble",
              "bake",
              "beat",
              "blend",
              "boil",
              "broil",
              "chill",
              "chop",
              "combine",
              "cool",
              "cut",
              "fold",
              "frost",
              "fry",
              "garnish",
              "grill",
              "knead",
              "marinate",
              "melt",
              "mix",
              "preheat",
              "proof",
              "reduce",
              "rest",
              "roast",
              "saute",
              "season",
              "serve",
              "simmer",
              "steam",
              "stir",
              "toast",
              "whisk"
            ]
          },

          "content": {
            "type": "string",
            "minLength": 1
          },

          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },

    "timings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "value",
          "unit"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },

          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },

          "unit": {
            "type": "string",
            "enum": [
              "minute"
            ]
          }
        },
        "additionalProperties": false
      }
    },

    "servings": {
      "type": "number",
      "exclusiveMinimum": 0
    },

    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "tags.flattened.json"
      }
    },

    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "nutrition": {
      "type": "object",
      "properties": {
        "calories": {
          "type": "number",
          "minimum": 0
        },
        "protein": {
          "type": "number",
          "minimum": 0
        },
        "fat": {
          "type": "number",
          "minimum": 0
        },
        "carbohydrates": {
          "type": "number",
          "minimum": 0
        },
        "fiber": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "string",
      "minLength": 1
    },

    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "hard"
      ]
    }
  },

  "$defs": {
    "ingredient": {
      "type": "object",

      "required": [
        "item"
      ],

      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },

        "volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "weight_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "count": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "optional": {
          "type": "boolean"
        },

        "note": {
          "type": "string",
          "minLength": 1
        },

        "substitutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/substituteIngredient"
            }
          }
        }
      },

      "anyOf": [
        {
          "required": [
            "volume_ml"
          ]
        },
        {
          "required": [
            "weight_g"
          ]
        },
        {
          "required": [
            "count"
          ]
        }
      ],

      "additionalProperties": false
    },

    "substituteIngredient": {
      "type": "object",

      "required": [
        "item"
      ],

      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },

        "volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "weight_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "count": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "optional": {
          "type": "boolean"
        },

        "note": {
          "type": "string",
          "minLength": 1
        }
      },

      "anyOf": [
        {
          "required": [
            "volume_ml"
          ]
        },
        {
          "required": [
            "weight_g"
          ]
        },
        {
          "required": [
            "count"
          ]
        }
      ],

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}