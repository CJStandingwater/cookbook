{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "type": "object",

  "required": [
    "id",
    "title",
    "authors",
    "ingredients",
    "instructions"
  ],

  "properties": {
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1
          },

          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.json#/$defs/ingredient"
            }
          }
        },
        "additionalProperties": false
      }
    },

    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action",
          "content"
        ],
        "properties": {
          "action": {
            "type": "string",
            "$ref": "actions.enum.json"
          },

          "content": {
            "type": "string",
            "minLength": 1
          },

          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },

    "timings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "minutes"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },

          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },

    "servings": {
      "type": "number",
      "exclusiveMinimum": 0
    },

    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "tags.flattened.json"
      }
    },

    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "nutrition": {
      "type": "object",
      "properties": {
        "calories": {
          "type": "number",
          "minimum": 0
        },
        "protein": {
          "type": "number",
          "minimum": 0
        },
        "fat": {
          "type": "number",
          "minimum": 0
        },
        "carbohydrates": {
          "type": "number",
          "minimum": 0
        },
        "fiber": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "string",
      "minLength": 1
    },

    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "difficulty": {
      "type": "string",
      "$ref": "difficulty.enum.json"
    }
  },

  "additionalProperties": false
}