{
  "$id": "common.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },

    "ingredient": {
      "type": "object",

      "required": [
        "ingredient"
      ],

      "properties": {
        "ingredient": {
          "type": "string",
          "minLength": 1
        },

        "form": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "forms.enum.json"
          }
        },

        "volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "weight_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "count": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "preferred_measurement": {
          "type": "object",
          "required": [
            "metric",
            "imperial"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "volume",
                "weight"
              ]
            },
            "imperial": {
              "type": "string",
              "enum": [
                "volume",
                "weight"
              ]
            }
          },
          "additionalProperties": false
        },

        "optional": {
          "type": "boolean"
        },

        "note": {
          "type": "string",
          "minLength": 1
        },

        "substitutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ingredient"
            }
          }
        }
      },

      "anyOf": [
        {
          "required": [
            "volume_ml"
          ]
        },
        {
          "required": [
            "weight_g"
          ]
        },
        {
          "required": [
            "count"
          ]
        }
      ],

      "allOf": [
        {
          "if": {
            "properties": {
              "preferred_measurement": {
                "type": "object",
                "properties": {
                  "metric": {
                    "const": "weight"
                  }
                },
                "required": [
                  "metric"
                ]
              }
            },
            "required": [
              "preferred_measurement"
            ]
          },
          "then": {
            "required": [
              "weight_g"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "preferred_measurement": {
                "type": "object",
                "properties": {
                  "metric": {
                    "const": "weight"
                  }
                },
                "required": [
                  "metric"
                ]
              }
            },
            "required": [
              "preferred_measurement"
            ]
          },
          "then": {
            "required": [
              "volume_ml"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "preferred_measurement": {
                "type": "object",
                "properties": {
                  "metric": {
                    "const": "weight"
                  }
                },
                "required": [
                  "imperial"
                ]
              }
            },
            "required": [
              "preferred_measurement"
            ]
          },
          "then": {
            "required": [
              "weight_g"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "preferred_measurement": {
                "type": "object",
                "properties": {
                  "metric": {
                    "const": "weight"
                  }
                },
                "required": [
                  "imperial"
                ]
              }
            },
            "required": [
              "preferred_measurement"
            ]
          },
          "then": {
            "required": [
              "volume_ml"
            ]
          }
        }
      ],

      "additionalProperties": false
    }
  }
}