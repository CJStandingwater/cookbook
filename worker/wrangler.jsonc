{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cookbook-submissions",
	"main": "src/index.js",
	"compatibility_date": "2026-10-03",
	"d1_databases": [
		{
			"binding": "COOKBOOK_DB",
			"database_name": "cookbook-index",
			"database_id": "a4282062-e420-42ae-9492-1f708a4e5854"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SUBMISSION_LIMITER",
				"class_name": "SubmissionLimiter"
			}
		]
	},
	"exports": {
		"SubmissionLimiter": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"secrets": {
		"required": [
			"RESEND_API_KEY",
			"SUBMISSION_FROM",
			"SUBMISSION_TO",
			"INDEX_API_KEY"
		]
	}
}