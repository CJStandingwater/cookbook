  "instructions": [
    {
      "action": "combine",
      "content": "Combine hash browns, ham, onion, celery, chicken broth, salt, pepper, and garlic powder in a slow cooker. Stir well and cover."
    },
    {
      "action": "simmer",
      "content": "Cook on Low until the celery is soft, 4 to 5 hours."
    },
    {
      "action": "stir",
      "content": "Mix in cream cheese and Cheddar cheese, stirring until melted. Cover and cook on Low for another 30 minutes, stirring occasionally."
    },
    {
      "action": "serve",
      "content": "Serve topped with chopped green onions."
    }
  ],
